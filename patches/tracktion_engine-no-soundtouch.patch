 #ifdef __clang__
  #pragma clang diagnostic pop
@@ -46,6 +48,28 @@ namespace tracktion::inline engine {
  #pragma GCC diagnostic pop
 #endif
 
+#if ! TRACKTION_ENABLE_TIMESTRETCH_SOUNDTOUCH
+/** Tempo detection needs SoundTouch: without it, this never finds a tempo (getBpm() is -1). */
+class TempoDetect
+{
+public:
+    TempoDetect (int, double) {}
+
+    float processReader (juce::AudioFormatReader&)                      { return bpm; }
+    float processAndDetect (const float** const, int)                   { return bpm; }
+    float getBpm() const                                                { return bpm; }
+    bool isBpmSensible() const                                          { return false; }
+    static juce::Range<float> getSensibleRange()                        { return { 29, 200 }; }
+    void processSection (juce::AudioBuffer<float>&, int)                {}
+    void processSection (const float* const*, int)                      {}
+    float finishAndDetect()                                             { return bpm; }
+
+private:
+    float bpm = -1.0f;
+
+    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (TempoDetect)
+};
+#else
 /**
     Uses the SoundTouch BPMDetect class to guess the tempo of some audio.
 */
@@ -137,5 +161,6 @@ private:
 
     JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (TempoDetect)
 };
+#endif
 
 } // namespace tracktion::inline engine
