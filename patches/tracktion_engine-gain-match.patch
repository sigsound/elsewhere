+static float meanSquare (const choc::buffer::ChannelArrayView<float>& v)
+{
+    double sum = 0.0;
+    const auto numFrames = v.getNumFrames();
+
+    for (choc::buffer::ChannelCount c = 0; c < v.getNumChannels(); ++c)
+    {
+        auto* d = v.getChannel (c).data.data;
+
+        for (choc::buffer::FrameCount i = 0; i < numFrames; ++i)
+            sum += (double) d[i] * d[i];
+    }
+
+    const auto n = (double) numFrames * v.getNumChannels();
+    return n > 0 ? (float) (sum / n) : 0.0f;
+}
+
+void PluginNode::applyGainMatch (choc::buffer::ChannelArrayView<float> output, float inputMeanSquare)
+{
+    const auto numFrames = output.getNumFrames();
+
+    if (numFrames == 0 || sampleRate <= 0)
+        return;
+
+    // Levels are averaged over about a second and a half, so the gain follows the sound's overall
+    // loudness rather than each note
+    const auto blockSeconds = numFrames / sampleRate;
+    const auto keep = (float) std::exp (-blockSeconds / 1.5);
+    gainMatchIn  = gainMatchIn  * keep + inputMeanSquare * (1.0f - keep);
+    gainMatchOut = gainMatchOut * keep + meanSquare (output) * (1.0f - keep);
+
+    // Only match while both sides have something to measure (about -70 dB); otherwise hold
+    constexpr float floor = 1.0e-7f;
+    auto target = gainMatchGain;
+
+    if (gainMatchIn > floor && gainMatchOut > floor)
+        target = juce::jlimit (0.063f, 15.85f, std::sqrt (gainMatchIn / gainMatchOut));   // +/-24 dB
+
+    const auto start = gainMatchGain;
+    gainMatchGain = target;
+
+    for (choc::buffer::ChannelCount c = 0; c < output.getNumChannels(); ++c)
+    {
+        auto* d = output.getChannel (c).data.data;
+
+        for (choc::buffer::FrameCount i = 0; i < numFrames; ++i)
+            d[i] *= start + (target - start) * ((float) i / (float) numFrames);
+    }
+
+    plugin->gainMatchDb.store (juce::Decibels::gainToDecibels (target), std::memory_order_relaxed);
+}
